Object = hidestripe
  IsisVersion       = "3.1.0 | 2006-08-28"
  ProgramVersion    = 2006-08-17
  ExecutionDateTime = 2006-09-29T13:12:00
  HostName          = cnode07
  UserName          = hiroc
