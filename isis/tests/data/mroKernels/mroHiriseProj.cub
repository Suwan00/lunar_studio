End_Object

Object = cubenorm
  IsisVersion       = "3.1.0 | 2006-08-28"
  ProgramVersion    = 2005-09-09
  ExecutionDateTime = 2006-09-29T13:12:02
  HostName          = cnode07
  UserName          = hiroc
  Description       = "Normalize columns or lines in a cube"

  Group = UserParameters
    FROM       = /tmp/TRA_000823_1720_RED4_0.hidestripe.cub
    TO         = /HiRISE/Data/HiCal/TRA/ORB_000800_000899/TRA_000823_1720/TRA_000823_1720_RED4_0.temp.cub+SignedWord+0.0:3.0
